# ============================================================
# Z-View .gitignore
# ============================================================

# --- Python runtime caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.pytest_cache/

# --- Node / frontend build artifacts
node_modules/
dist/
.vite/

# --- Logs and temporary files
*.log
*.err.log
*.tmp
*.temp
findings.md

# --- IDE / tool state
.trae/
.claude/
.agents/
.kilo/
.playwright-mcp/
kilo_tmp/

# --- Build artifacts and local tool output
build/
*.spec.bak
dist_agent/
dist_agent_onefile/
dist_updater/
dist_setup/
build_agent_work/
build_updater_work/
build_setup_work/
build_setup_meta.json
releases/
agent_upgrade/

# --- Secrets, private keys, and local machine config
# Never commit any private key material
*-key.pem
*.key
*.p12
*.pfx
*.secret

# Runtime-generated cert directories (re-generated on demand)
frontend/certs/
wt_certs/

# Per-machine environment and config
.env
.env.local
config.json
config.local.json
auth_secret.txt
auth_state.json
agent_secret.txt

# Code signing private key (never commit)
signing/

# GPO deployment package runtime config
GPO部署包/config.json

# --- Service manager binary (build artifact)
ZViewServiceManager.exe
